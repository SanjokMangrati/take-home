{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "p6-schedule-checker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "CheckerContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 1,
      "constraints": {
        "regions": ["WNAM"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHECKER",
        "class_name": "CheckerContainer"
      }
    ]
  },
  "exports": {
    "CheckerContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "CHANGE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
